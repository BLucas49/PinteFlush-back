# Base de données (utilisée par l'API et docker compose)
DB_USER=pinteflush
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pinteflush

# Utilisée par dbmate pour les migrations
DATABASE_URL=postgres://pinteflush:change-me@localhost:5432/pinteflush?sslmode=disable

# Secret de signature des access tokens (32 caractères minimum)
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# "production" active les cookies Secure (HTTPS uniquement)
ENV=development
